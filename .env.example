# Copie a .env y ajuste. En Render las variables se definen en render.yaml / panel.
DATABASE_URL=postgres://sisalert:sisalert@localhost:5433/sisalert
JWT_SECRET=cambie-esto-por-un-valor-largo-y-aleatorio
PORT=3000
TZ=America/Bogota
APP_URL=http://localhost:3000

# Correo (Gmail SMTP: use una "contraseña de aplicación")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SISALERT <usuario@gmail.com>"

# WhatsApp (CallMeBot)
CALLMEBOT_ENABLED=true

# Google Calendar (cuenta de servicio; JSON completo o en base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Disparador externo de alertas: GET /api/cron/tick con header x-cron-secret
CRON_SECRET=cambie-esto

# Administrador inicial (si no se define: admin@avanzar.local / Admin2026! -> CAMBIAR tras el primer ingreso)
ADMIN_EMAIL=admin@avanzar.local
ADMIN_PASSWORD=Admin2026!

# Pruebas: "true" no envía nada, solo registra en alertas_log
MAIL_DRY_RUN=false
WA_DRY_RUN=false
